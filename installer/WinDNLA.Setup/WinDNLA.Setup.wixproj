<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>WinDLNA</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressIces>ICE03;ICE60</SuppressIces>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0.3</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\artifacts\publish\</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
