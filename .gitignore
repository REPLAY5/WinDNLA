## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/

*.log
*.vspscc
*.vssscc

# ffmpeg binaries
tools/ffmpeg/*.exe
tools/ffmpeg/*.dll
!tools/ffmpeg/README.md

# App local leftovers
*.db
*.db-shm
*.db-wal
