<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDNLA.App.ScanLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Лог сканирования">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Лог сканирования">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/logo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="16,8,16,16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind ViewModel.ScanSummary, Mode=OneWay}"
                       Opacity="0.75" TextTrimming="CharacterEllipsis" />
            <Border Grid.Row="1"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView
                    x:Name="ScanLogList"
                    ItemsSource="{x:Bind ViewModel.ScanLog, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="10,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="12"
                                       FontFamily="Cascadia Mono, Consolas"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.9" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
