<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDNLA.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:vm="using:WinDNLA.App.ViewModels"
    Title="WinDNLA"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="WinDNLA"
            LeftClickCommand="{x:Bind ShowWindowCommand}"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <ToggleMenuFlyoutItem
                        x:Name="AutostartMenuItem"
                        Text="Автозагрузка"
                        Click="AutostartMenuItem_Click" />
                    <MenuFlyoutItem Text="Пересканировать" Click="RescanMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Выход"
                        Command="{x:Bind ExitCommand}"
                        Click="ExitMenuItem_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="AppTitleBar" Title="WinDNLA">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/logo.png" />
                </TitleBar.IconSource>
            </TitleBar>

            <ScrollViewer Grid.Row="1" Padding="24,8,24,12"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Width="760" HorizontalAlignment="Left">

                    <!-- Server -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Сервер" Style="{StaticResource SubtitleTextBlockStyle}" />

                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Имя" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{x:Bind ViewModel.FriendlyName, Mode=TwoWay}"
                                         PlaceholderText="WinDNLA"
                                         TextWrapping="NoWrap" />

                                <TextBlock Grid.Row="1" Text="Порт" Style="{StaticResource FieldLabel}" />
                                <NumberBox Grid.Row="1" Grid.Column="1"
                                           Value="{x:Bind ViewModel.HttpPort, Mode=TwoWay}"
                                           Minimum="1" Maximum="65535"
                                           SpinButtonPlacementMode="Compact" />

                                <TextBlock Grid.Row="2" Text="Интерфейсы" Style="{StaticResource FieldLabel}" />
                                <DropDownButton Grid.Row="2" Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Content="{x:Bind ViewModel.InterfacesSummary, Mode=OneWay}">
                                    <DropDownButton.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <StackPanel MinWidth="320" Spacing="4">
                                                <TextBlock Text="Где анонсировать DLNA"
                                                           Opacity="0.7" FontSize="12" Margin="4,0,4,6" />
                                                <ScrollViewer MaxHeight="320">
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.NetworkInterfaces, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:NetworkInterfaceItem">
                                                                <CheckBox Content="{x:Bind DisplayName}"
                                                                          IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                          Margin="0,1" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="252" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="{x:Bind ServerToggleLabel, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Width="120"
                                            Click="ToggleServer_Click" />
                                    <Button Content="Выход"
                                            Width="120"
                                            Command="{x:Bind ExitCommand}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind StatusDotBrush, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.ServerStatus, Mode=OneWay}"
                                               Opacity="0.85"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2"
                                              Header="Автозагрузка"
                                              IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}"
                                              Toggled="AutostartToggle_Toggled"
                                              OffContent="Нет" OnContent="Да"
                                              HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Folders -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Папки с видео" Style="{StaticResource SubtitleTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Click="OpenScanLog_Click"
                                        ToolTipService.ToolTip="Лог сканирования"
                                        Padding="6"
                                        MinWidth="36" MinHeight="36">
                                    <Grid Width="22" Height="22">
                                        <ProgressRing Width="18" Height="18"
                                                      IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                                      Visibility="{x:Bind VisibleWhen(ViewModel.IsScanning), Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16"
                                                  Visibility="{x:Bind VisibleWhenNot(ViewModel.IsScanning), Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <ListView
                                ItemsSource="{x:Bind ViewModel.LibraryRoots, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedRoot, Mode=TwoWay}"
                                MinHeight="72"
                                MaxHeight="160"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="10" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Opacity="0.75" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="AddFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                            <TextBlock Text="Добавить" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.RemoveSelectedFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            <TextBlock Text="Удалить" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.RescanCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            <TextBlock Text="Пересканировать" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind LibrarySummary, Mode=OneWay}"
                                           Opacity="0.7" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Transcode -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Перекодирование" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="На лету, если расширение или кодек не из списка (h264 / h265)."
                                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,4,16,0" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.TranscodingEnabled, Mode=TwoWay}"
                                              OffContent="Выкл" OnContent="Вкл" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.TranscodeRules, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TranscodeRuleItem">
                                        <Grid ColumnSpacing="8" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                                      Content="Вкл" MinWidth="0" />
                                            <TextBox Grid.Column="1"
                                                     PlaceholderText=".avi, .mkv"
                                                     Text="{x:Bind ExtensionsText, Mode=TwoWay}" />
                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{x:Bind MatchNonAllowedCodecs, Mode=TwoWay}"
                                                      Content="Не h264/h265" />
                                            <TextBox Grid.Column="3"
                                                     PlaceholderText="h264, hevc"
                                                     Text="{x:Bind AllowedCodecsText, Mode=TwoWay}" />
                                            <Button Grid.Column="4"
                                                    Tag="{x:Bind}"
                                                    Click="RemoveRule_Click"
                                                    ToolTipService.ToolTip="Удалить правило"
                                                    Padding="8,4">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Command="{x:Bind ViewModel.AddTranscodeRuleCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Добавить правило" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Clients -->
            <Grid Grid.Row="2" Padding="24,0,24,16"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ClientsHeader, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,12,0,8" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}">
                    <ListView.Header>
                        <Grid Padding="12,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IP" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="1" Text="Файл" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="2" Text="Мбит/с" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="3" Text="Транскод" FontWeight="SemiBold" Opacity="0.7" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ClientIp}" />
                                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding SpeedMbitPerSec}" />
                                <TextBlock Grid.Column="3" Text="{Binding TranscodingLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
