<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinDNLA.App</RootNamespace>
    <AssemblyName>WinDLNA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- WinUI unpackaged: SDK publish omits .pri/.xbf unless MSIX tooling is on. -->
  <Target Name="AddWinUiFilesToPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutputPath)$(AssemblyName).pri" Condition="Exists('$(OutputPath)$(AssemblyName).pri')">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyWinUiFilesAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_WinUiOut>$([MSBuild]::EnsureTrailingSlash('$(OutputPath)'))</_WinUiOut>
      <_WinUiPub>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_WinUiPub>
    </PropertyGroup>
    <ItemGroup>
      <_WinUiExtra Include="$(_WinUiOut)$(AssemblyName).pri" Condition="Exists('$(_WinUiOut)$(AssemblyName).pri')" />
      <_WinUiExtra Include="$(_WinUiOut)*.xbf" />
      <_WinUiAssets Include="$(_WinUiOut)Assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUiExtra)" DestinationFolder="$(_WinUiPub)" SkipUnchangedFiles="true"
          Condition="'$(_WinUiOut)' != '$(_WinUiPub)' and '@(_WinUiExtra)' != ''" />
    <Copy SourceFiles="@(_WinUiAssets)"
          DestinationFiles="@(_WinUiAssets->'$(_WinUiPub)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(_WinUiOut)' != '$(_WinUiPub)' and '@(_WinUiAssets)' != ''" />
  </Target>

  <!-- Bundle ffmpeg next to the app when present -->
  <ItemGroup>
    <None Include="..\..\tools\ffmpeg\ffmpeg.exe" Condition="Exists('..\..\tools\ffmpeg\ffmpeg.exe')">
      <Link>ffmpeg\ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\tools\ffmpeg\ffprobe.exe" Condition="Exists('..\..\tools\ffmpeg\ffprobe.exe')">
      <Link>ffmpeg\ffprobe.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDNLA.Core\WinDNLA.Core.csproj" />
    <ProjectReference Include="..\WinDNLA.Dlna\WinDNLA.Dlna.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
